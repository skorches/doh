# DoH Server Environment Configuration
# Copy this file to .env and customize as needed

# Upstream DNS servers (comma-separated DoH URLs)
# Default: Cloudflare + Google
UPSTREAM_DNS=https://1.1.1.1/dns-query,https://1.0.0.1/dns-query,https://8.8.8.8/dns-query,https://8.8.4.4/dns-query

# DNS Cache TTL (in seconds)
# Higher values = better performance, but slower updates
CACHE_SUCCESS_TTL=3600
CACHE_DENIAL_TTL=60

# DNS Proxy Port (standard DNS port)
DNS_PORT=53

# DoH Server Internal Port
DOH_INTERNAL_PORT=5053

# HTTPS DoH Endpoint Port
DOH_HTTPS_PORT=8053

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info

# Enable query logging (true/false)
# Warning: Can generate large logs
ENABLE_QUERY_LOG=false

# Maximum concurrent DNS queries
MAX_CONCURRENT=1000

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=5

