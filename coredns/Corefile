# NCSI / NAT / Teredo: must get real Microsoft IPs, never the Smart DNS hosts file.
msftncsi.com {
    forward . tls://1.1.1.1 tls://1.0.0.1 {
        tls_servername cloudflare-dns.com
        policy sequential
        max_fails 2
        expire 30s
    }
    cache 120
    errors
}
