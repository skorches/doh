. {
    # Load custom hosts for pinned domains first
    hosts /etc/coredns/xbox-hosts {
        fallthrough
        reload 30s
        ttl 300
    }

    # DoT: plain DNS from the Docker bridge to 1.1.1.1:53 is often lossy on VPS; TLS :853 is not.
    forward . tls://1.1.1.1 tls://1.0.0.1 {
        tls_servername cloudflare-dns.com
        max_concurrent 2000
        policy sequential
        max_fails 2
        expire 30s
    }

    cache 3600 {
        success 3600
        denial 600
        prefetch 10 1m 10%
    }
    errors
}
